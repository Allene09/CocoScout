# Server
PORT=5000
NODE_ENV=development

# Database (Supports mysql or sqlite fallback)
DB_DIALECT=mysql
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=cocoscout

# Auth
JWT_SECRET=change_this_to_a_long_random_string_in_production
JWT_EXPIRES_IN=7d

# Uploads
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=25

# AI model
MODEL_PATH=models/best.onnx
CONFIDENCE_THRESHOLD=0.5

# Tree matching (meters)
TREE_MATCH_RADIUS_M=5

# CORS Client Origin (Vite default is 5173)
CLIENT_ORIGIN=http://localhost:5173
